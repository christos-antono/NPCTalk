<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the mod's network code (uploads, LLM, TTS, speech-to-text) outside the game to check keys and latency. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NpcVoice</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <!-- The mod's game-free half: everything here builds and runs without GTA. -->
    <Compile Include="..\..\mod\Net.cs;..\..\mod\Tts.cs;..\..\mod\VoiceLibrary.cs;..\..\mod\FalClient.cs;..\..\mod\MsgPack.cs;..\..\mod\Log.cs;..\..\mod\Llm.cs;..\..\mod\SpeechToText.cs;..\..\mod\OpenMic.cs;..\..\mod\Jev.cs;..\..\mod\LlmActionPicker.cs;..\..\mod\EngineConfig.cs;..\..\mod\ActionCatalog.cs;..\..\mod\Dialogue.cs" />
  </ItemGroup>
</Project>
